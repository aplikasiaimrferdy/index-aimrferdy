---
import MainLayout from "../layouts/MainLayout.astro";
import { getCollection } from "astro:content";

// ================= TOOLS =================
const toolModules = Object.entries(
  import.meta.glob('./tools/**/*.astro', { eager: true })
);

const tools = toolModules
  .map(([file, mod]) => {
    if (!mod.meta) return null;

    const url = file
      .replace('/src/pages', '')
      .replace('.astro', '');

    return {
      type: "tool",
      title: mod.meta.title,
      description: mod.meta.description || "",
      url
    };
  })
  .filter(Boolean);

// ================= BLOG =================
const posts = await getCollection("blog");

const blogs = posts.map(post => ({
  type: "blog",
  title: post.data.title,
  description: post.data.description || "",
  url: `/blog/${post.id}/`
}));

// ================= PAGES =================
const pageModules = Object.entries(
  import.meta.glob('./*.astro', { eager: true })
);

const pages = pageModules
  .map(([file, mod]) => {
    // skip cari itself
    if (file.includes('cari.astro')) return null;

    const name = file
      .replace('./', '')
      .replace('.astro', '');

    return {
      type: "page",
      title: name.toUpperCase(),
      description: `Halaman ${name}`,
      url: `/${name}`
    };
  })
  .filter(Boolean);

// ================= GABUNG =================
const allContent = [...tools, ...blogs, ...pages];
---

<MainLayout title="Cari">

<div class="search-container">

  <h1>Cari</h1>

  <input 
    id="search" 
    type="text" 
    placeholder="Cari tools, blog, atau halaman..."
  />

  <div id="results"></div>

  <div id="empty" style="display:none;">
    Tidak ditemukan
  </div>

</div>

<script is:inline>
  const data = JSON.parse(`{JSON.stringify(allContent)}`);

  const input = document.getElementById("search");
  const results = document.getElementById("results");
  const empty = document.getElementById("empty");

  input.addEventListener("input", () => {
    const q = input.value.toLowerCase();

    const filtered = data.filter(item =>
      (item.title || "").toLowerCase().includes(q) ||
      (item.description || "").toLowerCase().includes(q)
    );

    results.innerHTML = filtered.map(item => `
      <a href="${item.url}" class="card">
        <strong>${item.title}</strong>
        <p>${item.description}</p>
        <small>
          ${item.type === 'tool' ? '🛠 Tool' :
            item.type === 'blog' ? '📝 Blog' :
            '📄 Page'}
        </small>
      </a>
    `).join('');

    empty.style.display = filtered.length ? "none" : "block";
  });
</script>

<style>
.search-container {
  max-width: 700px;
  margin: auto;
  padding: 20px;
}

input {
  width: 100%;
  padding: 12px;
  margin-bottom: 20px;
}

.card {
  display: block;
  padding: 12px;
  border-bottom: 1px solid #ddd;
  text-decoration: none;
  color: inherit;
}

.card:hover {
  background: #f5f5f5;
}
</style>

</MainLayout>
