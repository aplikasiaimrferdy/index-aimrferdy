---
import MainLayout from "../layouts/MainLayout.astro";
import { getCollection } from "astro:content";

// =====================
// TOOLS
// =====================
const modules = Object.entries(
  import.meta.glob('./tools/**/*.astro', { eager: true })
);

const tools = modules
  .map(([file, mod]) => {
    if (!mod.meta) return null;

    const url = file
      .replace('/src/pages', '')
      .replace('.astro', '');

    return { url, ...mod.meta };
  })
  .filter(Boolean);

const featuredTools = tools.filter(t => t.featured).slice(0, 6);

// =====================
// BLOG
// =====================
const allPosts = await getCollection("blog");
const totalPosts = allPosts.length;

const posts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

// =====================
// SEO
// =====================
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "AI Mr Ferdy",
  url: "https://aimrferdy.com",
  potentialAction: {
    "@type": "SearchAction",
    target: "https://aimrferdy.com/blog?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "AI Mr Ferdy",
  url: "https://aimrferdy.com"
};
---

<MainLayout 
  title="AI Mr Ferdy - Tools AI Gratis untuk SEO, Konten & Produktivitas"
  description="Platform tools AI gratis untuk SEO, konten, teks, gambar, dan produktivitas digital tanpa install."
  url="https://aimrferdy.com"
>

<div class="home-container">

  <!-- HERO -->
  <section class="home-hero">
    <!-- H1 upgrade (tanpa ubah konsep besar) -->
    <h1>Tools AI Gratis untuk SEO, Konten & Produktivitas Digital 🚀</h1>

    <p>
      Gunakan tools gratis untuk SEO, teks, gambar, audio, dan lainnya.
      Tanpa install, langsung pakai.
    </p>

    <div class="hero-actions">
      <a href="/tools" class="btn-primary" title="Mulai Tools AI Gratis">🚀 Mulai Tools</a>
      <a href="/blog" class="btn-secondary" title="Baca Blog SEO AI">📚 Baca Blog</a>
    </div>
  </section>

  <!-- TRUST -->
  <section class="home-trust">
    <div><strong>{tools.length}+</strong> Tools</div>
    <div><strong>{totalPosts}+</strong> Artikel</div>
    <div><strong>100%</strong> Gratis</div>
    <div><strong>Fast</strong> & No Login</div>
  </section>

  <!-- 🔥 SEO CONTENT (TAMBAHAN RINGAN, AMAN) -->
  <section class="seo-content">
    <h2>Apa Itu AI Mr Ferdy?</h2>
    <p>
      AI Mr Ferdy adalah platform tools online gratis berbasis Artificial Intelligence
      yang membantu pembuatan konten, optimasi SEO, dan produktivitas digital.
      Semua tools dapat digunakan langsung tanpa instalasi.
    </p>
  </section>

  <!-- FEATURED TOOLS -->
  <section>
    <div class="section-head">
      <h2>🔥 Popular Tools</h2>
      <a href="/tools">Lihat semua →</a>
    </div>

    <div class="tools-grid">
      {featuredTools.map(tool => (
        <a href={tool.url} class="tool-card popular" title={tool.title}>
          <div class="badge">HOT</div>
          <h3>{tool.title}</h3>
          <p>{tool.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- BLOG -->
  <section>
    <div class="section-head">
      <h2>📚 Artikel Terbaru</h2>
      <a href="/blog">Lihat semua →</a>
    </div>

    <div class="blog-grid">
      {posts.map(post => (
        <a href={`/blog/${post.id}/`} class="blog-card">

          <div class="blog-thumb">
            <img 
              src={post.data.heroImage} 
              alt={`Artikel ${post.data.title} tentang SEO dan AI`}
              loading="lazy"
            />
          </div>

          <div class="blog-content">
            <h3>{post.data.title}</h3>

            <p class="blog-desc">
              {post.data.description?.slice(0, 80)}...
            </p>
          </div>

        </a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="home-cta">
    <h2>Mulai Gunakan Tools Sekarang</h2>
    <a href="/tools" class="btn-primary">Buka Tools 🚀</a>
  </section>

</div>

<!-- SEO -->
<script type="application/ld+json">
{JSON.stringify(jsonLd)}
</script>

<script type="application/ld+json">
{JSON.stringify(orgLd)}
</script>

<style>
.blog-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 20px;
}

.blog-card {
  display: block;
  border-radius: 14px;
  overflow: hidden;
  background: var(--card);
  border: 1px solid var(--border);
  transition: 0.25s;
  text-decoration: none;
  color: inherit;
}

.blog-card:hover {
  transform: translateY(-4px);
}

.blog-thumb {
  width: 100%;
  height: 160px;
  overflow: hidden;
}

.blog-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.blog-content {
  padding: 14px;
}

.blog-content h3 {
  font-size: 0.95rem;
  margin: 0 0 6px;
  line-height: 1.3;
}

.blog-desc {
  font-size: 0.8rem;
  color: var(--text-soft);
  line-height: 1.4;
}
</style>

</MainLayout>
