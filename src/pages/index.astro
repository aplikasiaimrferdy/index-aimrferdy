---
import MainLayout from "../layouts/MainLayout.astro";
import { getCollection } from "astro:content";

// =====================
// TOOLS
// =====================
const modules = Object.entries(
  import.meta.glob('./tools/**/*.astro', { eager: true })
);

const tools = modules
  .map(([file, mod]) => {
    if (!mod.meta) return null;

    const url = file
      .replace('/src/pages', '')
      .replace('.astro', '');

    return { url, ...mod.meta };
  })
  .filter(Boolean);

const featuredTools = tools.filter(t => t.featured).slice(0, 6);

// =====================
// BLOG
// =====================
const allPosts = await getCollection("blog");
const totalPosts = allPosts.length;

const posts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

// =====================
// SEO JSON-LD
// =====================
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "AI Mr Ferdy",
  url: "https://aimrferdy.com"
};
---

<MainLayout 
  title="AI Mr Ferdy - Platform AI & Tools Gratis untuk Konten dan SEO"
  description="AI Mr Ferdy adalah platform AI Indonesia untuk membuat konten, SEO, dan produktivitas digital dengan tools gratis tanpa install."
  url="https://aimrferdy.com"
>

<div class="home-container">

  <!-- 🔥 BRANDING (PENTING BANGET) -->
  <section class="home-hero">
    <h1>AI Mr Ferdy: Platform AI untuk Konten & Produktivitas Digital</h1>

    <p>
      AI Mr Ferdy adalah platform berbasis Artificial Intelligence yang menyediakan
      tools online gratis untuk membantu pembuatan konten, SEO, dan produktivitas digital.
    </p>

    <div class="hero-actions">
      <a href="/tools" class="btn-primary">🚀 Mulai Tools</a>
      <a href="/blog" class="btn-secondary">📚 Baca Blog</a>
    </div>
  </section>

  <!-- TRUST -->
  <section class="home-trust">
    <div><strong>{tools.length}+</strong> Tools</div>
    <div><strong>{totalPosts}+</strong> Artikel</div>
    <div><strong>100%</strong> Gratis</div>
    <div><strong>Fast</strong> & No Login</div>
  </section>

  <!-- APA ITU -->
  <section>
    <h2>Apa Itu AI Mr Ferdy?</h2>
    <p>
      AI Mr Ferdy adalah platform berbasis kecerdasan buatan (Artificial Intelligence)
      yang dirancang untuk membantu berbagai aktivitas digital seperti membuat konten,
      menjawab pertanyaan, hingga memberikan ide kreatif.
    </p>
  </section>

  <!-- FEATURED TOOLS -->
  <section>
    <div class="section-head">
      <h2>🔥 Popular Tools</h2>
      <a href="/tools">Lihat semua →</a>
    </div>

    <div class="tools-grid">
      {featuredTools.map(tool => (
        <a href={tool.url} class="tool-card popular">
          <div class="badge">HOT</div>
          <h3>{tool.title}</h3>
          <p>{tool.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- BLOG -->
  <section>
    <div class="section-head">
      <h2>📚 Artikel Terbaru</h2>
      <a href="/blog">Lihat semua →</a>
    </div>

    <div class="blog-grid">
      {posts.map(post => (
        <a href={`/blog/${post.id}/`} class="blog-card">

          <div class="blog-thumb">
            <img src={post.data.heroImage} alt={post.data.title} />
          </div>

          <div class="blog-content">
            <h3>{post.data.title}</h3>

            <p class="blog-desc">
              {post.data.description?.slice(0, 80)}...
            </p>
          </div>

        </a>
      ))}
    </div>
  </section>

  <!-- 🔥 KONTEN LAMA (JANGAN DIHAPUS - SEO POWER) -->
  <section>
    <h2>Review AI Mr Ferdy 2026: Cara Pakai, Fitur & Apakah Aman?</h2>

    <p>
      AI Mr Ferdy adalah platform AI yang saat ini banyak dicari di Indonesia.
      Banyak pengguna ingin tahu apakah AI Mr Ferdy benar-benar berguna, aman, atau justru scam.
    </p>

    <h3>Kenapa AI Mr Ferdy Populer?</h3>
    <ul>
      <li>Mudah digunakan bahkan untuk pemula</li>
      <li>Akses cepat tanpa instalasi</li>
      <li>Cocok untuk konten & produktivitas</li>
    </ul>

    <h3>Fitur Utama</h3>
    <ul>
      <li>AI Chatbot</li>
      <li>Generator Konten</li>
      <li>AI Copywriting</li>
      <li>Akses Gratis</li>
    </ul>

    <h3>Cara Menggunakan</h3>
    <ol>
      <li>Buka platform</li>
      <li>Masukkan prompt</li>
      <li>Dapatkan hasil</li>
    </ol>

    <h3>Apakah AI Mr Ferdy Aman?</h3>
    <p>
      Aman selama tidak memasukkan data sensitif dan menggunakan akses resmi.
    </p>

    <p>
      👉 <strong>Coba sekarang:</strong><br/>
      <a href="https://heylink.me/mrferdy" rel="nofollow">https://heylink.me/mrferdy</a>
    </p>
  </section>

  <!-- CTA -->
  <section class="home-cta">
    <h2>Mulai Gunakan Tools Sekarang</h2>
    <a href="/tools" class="btn-primary">Buka Tools 🚀</a>
  </section>

</div>

<!-- JSON-LD -->
<script type="application/ld+json">
{JSON.stringify(jsonLd)}
</script>

<style>
.blog-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 20px;
}

.blog-card {
  display: block;
  border-radius: 14px;
  overflow: hidden;
  background: var(--card);
  border: 1px solid var(--border);
  transition: 0.25s;
  text-decoration: none;
  color: inherit;
}

.blog-card:hover {
  transform: translateY(-4px);
}

.blog-thumb {
  width: 100%;
  height: 160px;
  overflow: hidden;
}

.blog-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.blog-content {
  padding: 14px;
}

.blog-content h3 {
  font-size: 0.95rem;
  margin: 0 0 6px;
}

.blog-desc {
  font-size: 0.8rem;
  color: var(--text-soft);
}
</style>

</MainLayout>
