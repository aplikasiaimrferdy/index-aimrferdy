<div class="tool-box">

  <h1>🔥 AI Hook TikTok Generator</h1>
  <p class="desc">Bikin hook viral yang bikin orang STOP SCROLL 🚀</p>

  <!-- FORM -->
  <div class="form-group">
    <label>Topik</label>
    <input 
      id="topic" 
      placeholder="Contoh: jualan online, affiliate, motivasi..."
    />
  </div>

  <div class="form-group">
    <label>Gaya Hook</label>
    <select id="style">
      <option value="shock">😱 Shock</option>
      <option value="story">📖 Story</option>
      <option value="problem">❗ Problem</option>
      <option value="urgent">⚡ Urgent</option>
    </select>
  </div>

  <!-- BUTTON -->
  <div class="btn-group">
    <button id="generateBtn" class="primary">🚀 Generate Hook</button>
    <button id="copyBtn">📋 Copy</button>
  </div>

  <!-- RESULT -->
  <div class="form-group">
    <label>Hasil Hook</label>
    <textarea 
      id="result" 
      placeholder="Hasil hook akan muncul di sini..."
    ></textarea>
  </div>

</div>
