---
const {
  title = "Tools Online Gratis",
  description = "Tools gratis SEO, AI, converter",
  url = "https://aimrferdy.net"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="canonical" href={url} />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">

  <!-- OG -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={url} />

  <!-- TWITTER -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
<link href='/fav.png' rel='icon' type='image/x-icon'/>
  <!-- JSON-LD -->
  <script type="application/ld+json">
  {JSON.stringify({
    "@context":"https://schema.org",
    "@type":"WebSite",
    "name": title,
    "description": description,
    "url": url
  })}
  </script>

  <link rel="stylesheet" href="/styles/global.css">
  <link rel="stylesheet" href="/styles/tools.css">
</head>

<body>

<!-- HEADER -->
<header>
  <div class="menu-btn" onclick="toggleMenu()">☰</div>

  <div class="logo">
    <img src="/fav.png" alt="AI Mr Ferdy">
  </div>

  <nav id="navMenu">
    <div class="close-btn" onclick="toggleMenu()">✕ Tutup</div>
    <a href="/">Home</a>
    <a href="/tools">Tools</a>
    <a href="/blog">Blog</a>
    <a href="/about">Tentang</a>
  </nav>

  <div class="toggle" onclick="toggleMode()" id="modeIcon">🌙</div>
</header>

<!-- CONTENT -->
<main class="container">
  <slot />
</main>

<!-- FOOTER -->
<footer>

<div class="footer-container footer">
<div class="footer-grid">

<div>
<div class="footer-title">🔥 Popular Tools</div>
  <a href="/tools/qr">QR Code Generator</a>
  <a href="/tools/image-converter">Image Converter</a>
  <a href="/tools/social/youtube-thumbnail-downloader">YouTube Thumbnail</a>
  <a href="/tools/text/json-formatter">JSON Formatter</a>
</div>

<div>
<div class="footer-title">Informasi</div>
<a href="/">Home</a>
<a href="/about">Tentang</a>
<a href="/contact">Kontak</a>
<a href="/privacy">Privacy</a>
<a href="/disclaimer">Disclaimer</a>
</div>

<div>
<div class="footer-title">📂 Categories</div>
  <a href="/tools/text">Text Tools</a></li>
  <a href="/tools/image">Image Tools</a></li>
  <a href="/tools/generator">Generator</a></li>
  <a href="/tools/seo">SEO Tools</a></li>
  <a href="/tools/audio">Audio Tools</a></li>
  <a href="/tools/social">Social Tools</a></li>
</div>

