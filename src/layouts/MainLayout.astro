<div class="footer-title">Ai Mr Ferdy</div>
<p><strong>AI Mr Ferdy</strong> adalah platform yang menyediakan kumpulan tools online berbasis teknologi Artificial Intelligence (AI) dan utility digital <a href="/about">Selengkapnya</a></p>
</div>
-->

</div>

<div class="footer-bottom">
<a href="https://www.dmca.com/r/m23dgx1" title="DMCA.com Protection Status" class="dmca-badge"> <img src ="https://images.dmca.com/Badges/dmca-badge-w100-5x1-01.png?ID=7ab8b020-57e8-480b-8e93-186fc3eaba14"  alt="DMCA.com Protection Status" /></a> 
<br/>
© 2026 AI MR FERDY
</div>

</div>

</footer>

<!-- SCRIPT -->
<script>
window.toggleMenu = function () {
  document.getElementById("navMenu").classList.toggle("active");
};

window.toggleMode = function () {
  const html = document.documentElement;
  html.classList.toggle("light-mode");

  const icon = document.getElementById("modeIcon");

  if (html.classList.contains("light-mode")) {
    localStorage.setItem("theme", "light");
    if (icon) icon.textContent = "☀️";
  } else {
    localStorage.setItem("theme", "dark");
    if (icon) icon.textContent = "🌙";
  }
};

window.addEventListener("DOMContentLoaded", () => {
  const theme = localStorage.getItem("theme");
  const icon = document.getElementById("modeIcon");

  if (theme === "light") {
    document.documentElement.classList.add("light-mode");
    if (icon) icon.textContent = "☀️";
  }
});
</script>

</body>
</html>
